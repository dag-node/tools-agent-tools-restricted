# SPDX-License-Identifier: AGPL-3.0-only
# Test-image only: runs the upgrade transaction selftest once, after the system instance is up and networking is
# online (the scenarios install ai-tools-assets-core from the signed repository), then stops the container with
# the aggregate status via `systemctl exit` from the script.
[Unit]
Description=ai-tools RPM upgrade transaction selftest
After=network-online.target systemd-user-sessions.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ai-tools-upgrade-selftest
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
