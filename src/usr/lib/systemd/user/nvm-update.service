# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=Update sandbox Node.js (nvm) and global npm tools
Documentation=https://github.com/nvm-sh/nvm
Documentation=man:systemd.service(5)
# No network-online.target ordering: this is started by a daily timer on a long-running machine, so
# connectivity is a runtime condition, not a startup one. The updater treats an unreachable registry
# as transient (exit 3, stamped "skipped") and Restart= retries it.
# The retry is bounded: 6 starts per 6h at RestartSec covers a ~2.5h outage, after which the
# unit stops trying and `ai-tools --status` reports the run as stale.
StartLimitIntervalSec=6h
StartLimitBurst=6

[Service]
Type=oneshot
# Runs in the sandbox account's own systemd --user instance (%h=/opt/ai-tools): the
# updater writes the shared .nvm tree directly as ai-tools, resolves the latest LTS in
# the NVM_NODE_MAJOR series itself, and repoints the bin/claude symlink through the
# handback SYMLINK verb. See .claude/rules/updater.rule.md.
ExecStart=/opt/ai-tools/bin/nvm-update.sh

# /usr/local/bin carries ai-tools-handback-client (the SYMLINK repoint path); the script
# sources nvm.sh to put the active node/npm on PATH.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h
Environment=NVM_DIR=%h/.nvm
Environment=NVM_NODE_ALIAS=default
# The Node LTS series the updater tracks. To follow a different one on this host:
#   sudo systemctl --user -M ai-tools@.host edit nvm-update.service
Environment=NVM_NODE_MAJOR=22
# AI_TOOLS_GLOBAL_TOOLS is intentionally unset: the managed tool set defaults to npm plus each
# enabled agent's npm package, resolved from the agent manifests (providers.lib.sh), so the unit
# does not hardcode an agent. Set it here only to override that set for a bespoke deployment.

# Retry a TRANSIENT failure (exit 3: the registry was unreachable, the toolchain was left
# unchanged), so a host that reconnects within the window updates itself instead of waiting for
# tomorrow's timer.
# RestartPreventExitStatus=1 is what keeps that from being a retry loop over a real fault: exit 1 is
# the updater's "this host is broken and will still be broken on a retry" -- no nvm, no curl, an
# unset alias, a FAILED SIGNATURE CHECK -- and none of those should churn against the registry. An
# unclassified status still retries, bounded by the start limit.
Restart=on-failure
RestartPreventExitStatus=1
RestartSec=30min

# The updater writes its own .nvm tree as ai-tools and reaches the locked bin/ through
# the handback socket, so the session runs with no privilege escalation.
NoNewPrivileges=yes
# No mount-namespace option here, and this is a correctness requirement rather than a preference.
# systemd.exec(5): such an option "is only available for system services, or for services running
# in per-user instances of the service manager in which case PrivateUsers= is implicitly enabled".
# PrivateUsers maps this account's uid alone, so every other host uid -- root included -- reads
# back as the overflow uid 65534 while stat(1) still exits 0. The updater then resolves its agents
# through ai_tools_conf_is_trusted, which requires owner 0, so it refuses operator.conf and every
# manifest and ends the run as a fault. RestrictNamespaces= does NOT prevent this: it filters
# the payload's own unshare/clone/setns, and systemd builds the namespace before installing that
# filter. tests/integration/systemd.sh asserts the whole option family stays out of every --user
# unit. See .claude/rules/updater.rule.md.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nvm-update
