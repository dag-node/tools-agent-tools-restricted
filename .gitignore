.idea/
.env/
# Compiled policy packages ship PREBUILT -- the core (ai_tools.pp) and every optional
# group (ai_tools_<group>.pp) -- so a normal install and `ai-tools-admin selinux
# enable-group` need no selinux-policy-devel toolchain on the host. Track them all
# (the wildcard auto-tracks a new group so its .pp cannot be silently left unpackaged);
# ignore only the refpolicy build scratch under tmp/.
selinux/policy/*.pp
!selinux/policy/ai_tools.pp
!selinux/policy/ai_tools_*.pp
selinux/policy/tmp/
selinux/avc/.avc-last-run
selinux/avc/audits/
.avc-scratch/
ai_tools_exec_t
# Self-cleaning fixture dir from tests/integration/hooks.sh (left only if a run is killed).
.handback-test.*

# Python bytecode cache -- created next to the handback daemon/client when they are run or
# imported (e.g. a test loading the daemon); never a source artifact.
__pycache__/
*.pyc