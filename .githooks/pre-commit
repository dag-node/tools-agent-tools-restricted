#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
# pre-commit hook: report the prose figures the writing standard rules out, in the lines this commit ADDS. Reuses
# the checker the ai-tools-technical-writing skill of the pinned core release ships, resolved
# through tools/lib/assets.sh, so the hook and a full pass apply one set of patterns; where that pin is not in the cache
# the hook names the fetch command and exits 0 without a check.
#
# Never blocks, matching the commit-msg reminder beside it: the default checks report correct prose occasionally,
# and a hook that refuses a commit over a style call is a hook developers turn off. It reports, the author decides.
#
# Only the added lines are read. The tree is clean on these checks, so a hit here is something this commit introduces.
# A sentence split across a changed and an unchanged line is joined from the changed half alone, which is the one shape
# that reports a false hit; re-run the checker over the whole file before rewriting.
#
# Not installed automatically -- enable once per clone with `make -C packaging hooks` (sets core.hooksPath
# to .githooks).
set -euo pipefail

command -v python3 >/dev/null 2>&1 || exit 0
repo_root="$(git rev-parse --show-toplevel)"
# shellcheck source=SCRIPTDIR/../tools/lib/assets.sh
if ! source "${repo_root}/tools/lib/assets.sh" || ! checker="$(ai_tools_dev_assets__resolve_tool prose-check)"; then
    echo "pre-commit: the prose checker is not in the cache, so this commit was not checked; run: bash tools/lib/assets.sh fetch" >&2
    exit 0
fi

if ! python3 "${checker}" --staged; then
    echo "  (not blocking this commit)" >&2
fi

# The cross-reference check and the index, over the whole tree rather than the staged lines: a reference resolves
# against where its target is now, and a stale index is a property of the tree. Both report and neither blocks, like
# the prose report. Every staged file reaches them, documents and sources alike: a message code is defined inside
# the string a source file emits, so a commit that does not stage a document still moves what the index holds.
wrapper="${repo_root}/tools/generators/ref-index.sh"
if [[ -r "${wrapper}" ]] && git diff --cached --name-only --diff-filter=ACMR | grep -q .; then
    bash "${wrapper}" check || echo "  (not blocking this commit)" >&2
    bash "${wrapper}" stale || echo "  (not blocking this commit)" >&2
fi
exit 0
